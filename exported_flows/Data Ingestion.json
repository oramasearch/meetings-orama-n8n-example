    {
      "parameters": {
        "jsCode": "const finalArray = [];\nlet chunk = []\nconst chunkSize = 100;\n// $input.first().json.output.text\nconst meetingsInfo = $('Extract Transcript').all()\nlet idx = 0\nfor (const item of $input.all()) {\n  const data = item.json;\n  const meetingInfo = meetingsInfo[idx].json\n  chunk.push({\n    id: meetingInfo['Meeting_UID'],\n    summary: data?.output?.text,\n    date: meetingInfo['Date'],\n    meeting_item: meetingInfo['Item_UID'],\n    [\"Meeting Uid\"]: meetingInfo['Meeting_UID']\n\n  });\n  if (chunk.length >= chunkSize) {\n    finalArray.push({ data: chunk });\n    chunk = [];\n  }\n  idx++\n}\n\nif (chunk.length) {\n  finalArray.push({ data: chunk });\n}\n\nreturn finalArray;"
      },
